# ===== AI-конструктор КП =====
# Скопируйте этот файл в .env и заполните свои значения.
# .env НЕ хранится в git (см. .gitignore).

# ИИ-провайдер: gigachat | yandex
AI_PROVIDER=gigachat

# --- GigaChat (Сбер) ---
# GIGACHAT_API_KEY — полный ключ авторизации (base64 от client_id:client_secret),
# выдаётся в личном кабинете GigaChat.
GIGACHAT_API_KEY=
# Можно переопределить базовые URL и модель, если понадобится:
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_MODEL=GigaChat:latest

# --- YandexGPT (Yandex Cloud / AI Studio) ---
# Получение: console.yandex.cloud -> каталог (YANDEX_FOLDER_ID) ->
# сервисный аккаунт с ролью ai.languageModels.user -> API-ключ (YANDEX_API_KEY).
# Подробнее см. README.md.
# YANDEX_API_KEY=AQVN...
# YANDEX_FOLDER_ID=b1g...
# YANDEX_MODEL=yandexgpt-lite

# Таймаут запроса к ИИ, секунд (по ТЗ не более 60)
AI_TIMEOUT=60